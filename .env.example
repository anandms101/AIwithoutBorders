# Outpost configuration (docs/ARCHITECTURE.md §8)
# Copy to .env and adjust. All values have working defaults in outpost/config.py.

# --- Filesystem ---------------------------------------------------------------
# ARCHITECTURE §2 specifies /data. That needs root on this box, so the default is
# repo-local ./data. On the demo box, create /data and set OUTPOST_DATA_ROOT=/data.
OUTPOST_DATA_ROOT=./data
OUTPOST_DB=./data/outpost.db
OUTPOST_INBOX=./data/inbox
OUTPOST_ARTIFACTS=./data/artifacts

# --- Site / alerting ----------------------------------------------------------
OUTPOST_SITE_ID=OP-001
OUTPOST_HEARTBEAT_SECONDS=30
OUTPOST_ALERT_MIN_CASES=3
OUTPOST_ALERT_WINDOW_HOURS=72

# --- Egress -------------------------------------------------------------------
# The ONE allowlisted host. Q4 is unresolved; defaulting to a second local port.
# Point at a teammate's laptop IP for the recording.
OUTPOST_EGRESS_URL=http://127.0.0.1:9000/report

# --- Ollama -------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Invariant 6: models must stay resident or the always-on claim collapses.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=4

# --- Model roles --------------------------------------------------------------
# Nemotron 3 Super is not on this box. gemma4:12b is the only model verified
# end-to-end through OpenClaw. See docs/DECISIONS.md.
OUTPOST_AGENT_MODEL=gemma4:12b
OUTPOST_VISION_MODEL=medgemma:latest
OUTPOST_EMBED_MODEL=embeddinggemma:300m
OUTPOST_ASR_MODEL=large-v3
OUTPOST_ASR_LANGUAGE=fr

# Resident memory is driven by context length, not parameter count. `ollama ps`
# showed phi4-mini:3.8b holding 20GB purely from a 131k default context.
OUTPOST_AGENT_NUM_CTX=8192
OUTPOST_VISION_NUM_CTX=4096

OUTPOST_REQUEST_TIMEOUT_SECONDS=180
